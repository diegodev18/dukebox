{
  "name": "@dukebox/transport",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "How the desktop app reaches the control plane",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/rewrite-dist-aliases.mjs",
    "typecheck": "tsc -b --pretty && node ../../scripts/rewrite-dist-aliases.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@dukebox/protocol": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
