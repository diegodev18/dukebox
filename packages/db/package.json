{
  "name": "@dukebox/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Database schema and migrations",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/rewrite-dist-aliases.mjs",
    "typecheck": "tsc -b --pretty && node ../../scripts/rewrite-dist-aliases.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@dukebox/protocol": "workspace:*",
    "drizzle-orm": "^0.38.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
