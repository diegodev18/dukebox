{
  "name": "@dukebox/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent adapters that normalize agent output into AgentEvents",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/rewrite-dist-aliases.mjs",
    "typecheck": "tsc -b --pretty && node ../../scripts/rewrite-dist-aliases.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "inspect": "tsx src/claude-code/inspect.ts"
  },
  "dependencies": {
    "@dukebox/protocol": "workspace:*",
    "@dukebox/sandbox": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
