{
  "name": "@dukebox/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent adapters that normalize agent output into AgentEvents",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
