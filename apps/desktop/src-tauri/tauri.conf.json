{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dukebox",
  "version": "0.11.0",
  "identifier": "dev.dukebox.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dukebox",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "theme": null,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; frame-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Run coding agents on your own VPS",
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQ0I3RTgzNTYwRTZENkQKUldSdGJRNVdnMzdMTHRBb3pZbCt1N1BLRTFtZWN4TjFIdjU4VTY1UTlOM3lkV1R3K0ZVRFY5Q3gK",
      "endpoints": ["https://github.com/diegodev18/dukebox/releases/latest/download/latest.json"]
    }
  }
}
