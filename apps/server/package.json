{
  "name": "@dukebox/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Control plane",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b && node ../../scripts/rewrite-dist-aliases.mjs",
    "typecheck": "tsc -b --pretty && node ../../scripts/rewrite-dist-aliases.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@dukebox/adapters": "workspace:*",
    "@dukebox/db": "workspace:*",
    "@dukebox/protocol": "workspace:*",
    "@dukebox/sandbox": "workspace:*",
    "@dukebox/transport": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "drizzle-orm": "^0.38.2",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
